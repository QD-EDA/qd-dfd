#!/usr/bin/env python3
"""Check observed debug-lock behavior in a VCD trace."""

import argparse
import json
import re
import sys
from pathlib import Path


VALUE = re.compile(r"[01xXzZ]+\Z")


def load_policy(path):
    policy = json.loads(Path(path).read_text())
    if not isinstance(policy, dict):
        raise ValueError("policy must be a JSON object")
    signals = policy.get("signals")
    if not isinstance(signals, dict) or not {"reset", "lock", "request", "grant"} <= signals.keys():
        raise ValueError("policy signals must name reset, lock, request, and grant")
    if any(not isinstance(v, str) or not v for v in signals.values()):
        raise ValueError("signal paths must be non-empty strings")
    widths = policy.get("widths", {})
    if not isinstance(widths, dict) or set(widths) - signals.keys():
        raise ValueError("widths must map named signal roles to widths")
    if any(type(v) is not int or not 1 <= v <= 4096 for v in widths.values()):
        raise ValueError("signal widths must be integers from 1 through 4096")
    policy["widths"] = {role: widths.get(role, 1) for role in signals}
    by_path = {}
    for role, name in signals.items():
        width = policy["widths"][role]
        if name in by_path and by_path[name] != width:
            raise ValueError(f"conflicting policy widths for {name}")
        by_path[name] = width
    for key in ("forbidden", "required"):
        clauses = policy.get(key)
        if not isinstance(clauses, list) or not clauses:
            raise ValueError(f"policy {key} must be a non-empty list")
        for i, clause in enumerate(clauses):
            if not isinstance(clause, dict) or not isinstance(clause.get("when"), dict) or not clause["when"]:
                raise ValueError(f"{key}[{i}] must contain a non-empty when object")
            if set(clause["when"]) - signals.keys():
                raise ValueError(f"{key}[{i}] uses an unnamed signal role")
            if any(not isinstance(v, str) or not re.fullmatch("[01]+", v) or
                   len(v) != policy["widths"][role] for role, v in clause["when"].items()):
                raise ValueError(f"{key}[{i}] expected values must be 0 or 1 bit strings matching declared widths")
    return policy


def read_vcd(path, selected):
    """Return exact hierarchical declarations and final snapshots per timestamp."""
    tokens = iter(Path(path).read_text(errors="replace").split())
    scopes, declarations, updates = [], {}, []
    code_widths = {}
    wanted = set(selected)
    last_time, saw_time = 0, False

    def take():
        try:
            return next(tokens)
        except StopIteration as exc:
            raise ValueError("truncated VCD file") from exc

    def end_directive():
        for token in tokens:
            if token == "$end":
                return
        raise ValueError("unterminated VCD directive")

    def snapshots():
        current = {name: "x" * width for name, width in selected.items()}
        # VCD identifiers can alias multiple hierarchical declarations.
        codes = {code: [name for name in selected if declarations.get(name) == code]
                 for code in set(declarations.values())}
        result, pending = [], []
        snap_time = 0

        def flush():
            if pending:
                for code, value in pending:
                    for name in codes.get(code, ()):
                        current[name] = value
                result.append((snap_time, current.copy()))
                pending.clear()

        for item in updates:
            if item[0] == "time":
                if snap_time is not None and item[1] != snap_time:
                    flush()
                snap_time = item[1]
            else:
                pending.append((item[1], item[2]))
        flush()
        return result

    while True:
        try:
            token = next(tokens)
        except StopIteration:
            break
        if token == "$scope":
            kind, name = take(), take()
            if take() != "$end":
                raise ValueError("malformed $scope")
            scopes.append(name)
        elif token == "$upscope":
            if not scopes or take() != "$end":
                raise ValueError("malformed $upscope")
            scopes.pop()
        elif token == "$var":
            kind, width, code, ref = take(), int(take()), take(), take()
            end_directive()
            name = ".".join(scopes + [ref])
            if name in wanted:
                if width != selected[name]:
                    raise ValueError(f"selected signal {name} has width {width}; policy requires {selected[name]}")
                if code in code_widths and code_widths[code] != width:
                    raise ValueError(f"inconsistent VCD alias width for {name}")
                code_widths[code] = width
                if name in declarations:
                    raise ValueError(f"duplicate VCD declaration for {name}")
                declarations[name] = code
        elif token.startswith("#"):
            now = int(token[1:])
            if now < last_time:
                raise ValueError("VCD timestamps are not monotonic")
            updates.append(("time", now))
            last_time = now
            saw_time = True
        elif token.startswith("$"):
            # Dump controls delimit value blocks; metadata directives have bodies.
            if token == "$end":
                continue
            if token not in {"$dumpvars", "$dumpall", "$dumpon", "$dumpoff"}:
                end_directive()
        elif token[0] in "01xXzZ":
            value, code = token[0].lower(), token[1:]
            if code in code_widths:
                if code_widths[code] != 1:
                    raise ValueError(f"scalar VCD update for vector identifier {code}")
                updates.append(("value", code, value))
        elif token[0] in "bB":
            bits, code = token[1:].lower(), take()
            if code not in declarations.values():
                continue
            if not VALUE.fullmatch(bits):
                raise ValueError(f"unsupported VCD value {token}")
            if len(bits) > code_widths[code]:
                raise ValueError(f"VCD value exceeds declared width for identifier {code}")
            # VCD omits leading zeroes, or repeated leading X/Z bits.
            fill = bits[0] if bits[0] in "xz" else "0"
            updates.append(("value", code, bits.rjust(code_widths[code], fill)))
        elif token and token[0] in "rRhH":
            # Real/hex values cannot represent the required four-state boolean inputs.
            code = next(tokens, "")
            if code in declarations.values():
                raise ValueError("selected signals must use binary 0/1/X/Z values")

    missing = sorted(wanted - declarations.keys())
    if missing:
        raise ValueError("missing VCD signal(s): " + ", ".join(missing))
    if not saw_time and not updates:
        raise ValueError("VCD contains no value changes")
    return snapshots()


def check(vcd_path, policy):
    signals = policy["signals"]
    snapshots = read_vcd(vcd_path, {name: policy.get("widths", {}).get(role, 1) for role, name in signals.items()})
    diagnostics, exercised = [], [False] * len(policy["required"])

    def evaluate(clause, values, timestamp, label):
        unknown = []
        for role, expected in clause["when"].items():
            actual = values[signals[role]]
            if any(bit in "01" and bit != want for bit, want in zip(actual, expected)):
                return False
            if "x" in actual or "z" in actual:
                unknown.append((signals[role], actual))
        if unknown:
            rendered = ", ".join(f"{name}={value.upper()}" for name, value in unknown)
            diagnostics.append({"timestamp": timestamp, "kind": "unknown", "message": f"{label}: decisive value unknown ({rendered})", "signals": values.copy()})
            return False
        return True

    for timestamp, values in snapshots:
        for i, clause in enumerate(policy["required"]):
            if evaluate(clause, values, timestamp, f"required[{i}]"):
                exercised[i] = True
        for i, clause in enumerate(policy["forbidden"]):
            if evaluate(clause, values, timestamp, f"forbidden[{i}]"):
                diagnostics.append({"timestamp": timestamp, "kind": "forbidden", "message": f"forbidden[{i}] combination observed", "signals": values.copy()})

    for i, found in enumerate(exercised):
        if not found:
            diagnostics.append({"timestamp": None, "kind": "vacuous", "message": f"required[{i}] combination was not observed", "signals": {}})
    return diagnostics


def main(argv=None):
    parser = argparse.ArgumentParser(prog="qd-dfd")
    sub = parser.add_subparsers(dest="command", required=True)
    command = sub.add_parser("check", help="check observed debug-lock behavior in a VCD")
    command.add_argument("vcd")
    command.add_argument("--policy", required=True)
    command.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    try:
        policy = load_policy(args.policy)
        diagnostics = check(args.vcd, policy)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        diagnostics = [{"timestamp": None, "kind": "input", "message": str(exc), "signals": {}}]
    result = {"passed": not diagnostics, "diagnostics": diagnostics}
    if args.json:
        print(json.dumps(result, sort_keys=True))
    else:
        if not diagnostics:
            print("PASS: observed trace satisfies policy")
        for item in diagnostics:
            when = "" if item["timestamp"] is None else f" at {item['timestamp']}"
            detail = "" if not item["signals"] else " (" + ", ".join(f"{k}={v.upper()}" for k, v in sorted(item["signals"].items())) + ")"
            print(f"FAIL{when}: {item['message']}{detail}")
    return 0 if not diagnostics else 1


if __name__ == "__main__":
    sys.exit(main())
